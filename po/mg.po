msgid "Very good!"
msgstr "Tena tsara!"

#: page.py:258
msgid "Please try again."
msgstr "Andramo indray azafady."

#: IKnowMyABCs.py:116 IKnowMyABCs.py:118
msgid "listen to the letter names"
msgstr "henoy ireo anaran'ny litera"

